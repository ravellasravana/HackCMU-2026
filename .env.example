# All optional. Without any of these, Dining Car runs fully offline on the local
# receipt normalizer and the built-in recipe library.

# --- IFM K2 (default LLM provider) ---
K2_API_KEY=
K2_BASE_URL=https://api.ifm.ai/v1
K2_MODEL=IFM/K2-Horizon-375B-A23B

# --- Google Gemini (alternate LLM provider) ---
# Get a key from https://aistudio.google.com/apikey. Verify GEMINI_MODEL against
# Google's current model list; the value below was current at the time this was written.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Set to "gemini" to prefer Gemini when both K2_API_KEY and GEMINI_API_KEY are set.
# Defaults to "k2" so adding a Gemini key never silently changes existing K2 behavior.
LLM_PROVIDER=k2

# --- ElevenLabs (voice readout of tonight's plan) ---
# Get a key from https://elevenlabs.io. ELEVENLABS_VOICE_ID defaults to the
# public "Rachel" voice; swap in any voice id from your own account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
